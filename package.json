{
  "name": "vertical-motion-kit",
  "version": "1.0.0",
  "private": true,
  "description": "Анимации для вертикальных роликов на Remotion: заголовки, субтитры по словам, карточки, таймеры, переходы. Ничего не перекрывает лицо говорящего.",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Showreel out/showreel.mp4",
    "still": "remotion still Showreel out/preview.png --frame=60",
    "typecheck": "tsc --noEmit",
    "cut": "python tools/cut_pauses.py",
    "render:video": "remotion render Showreel out/showreel-video.mp4 --props=props.json"
  },
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "@remotion/transitions": "4.0.540",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
